    "build:styles": "node ../../../scripts/build-styles.mjs"
  },
  "peerDependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "dependencies": {
    "@react-cupertino-ui/shared": "*"
  }
}
