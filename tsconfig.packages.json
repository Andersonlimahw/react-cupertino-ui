      "@react-cupertino-ui/slider": [
        "./packages/ui/Slider"
      ],
      "@react-cupertino-ui/switcher": [
        "./packages/ui/Switcher"
      ],
      "@react-cupertino-ui/title": [
        "./packages/ui/Title"
      ],
      "@react-cupertino-ui/toast": [
        "./packages/ui/Toast"
      ]
    }
  }
}
