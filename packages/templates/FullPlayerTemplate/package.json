{
  "name": "@react-cupertino-ui/full-player-template",
  "version": "1.0.8",
  "description": "Full music player template for React Cupertino UI",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
