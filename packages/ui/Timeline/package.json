{
  "name": "@react-cupertino-ui/timeline",
  "version": "0.0.0",
  "description": "Timeline component for Cupertino-style progress/history flows",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": ["dist"],
  "sideEffects": [
    "./dist/**/*.css",
    "./dist/**/*.scss"
