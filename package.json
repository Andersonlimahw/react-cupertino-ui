{
  "name": "react-cupertino-ui",
  "private": false,
  "version": "1.0.0",
  "description": "iOS 26 Liquid Glass Components for React - 100+ accessible, TypeScript-first components",
  "type": "module",
  "author": "Anderson Lima <contato@lemon.dev.br>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/andersonlimahw/react-cupertino-ui"
  },
  "homepage": "https://react-cupertino-ui.pro",
  "bugs": {
    "url": "https://github.com/andersonlimahw/react-cupertino-ui/issues"
  },
  "keywords": [
    "react",
    "ios",
    "cupertino",
    "liquid-glass",
    "ui-components",
    "typescript",
    "apple-design",
    "ios-26",
    "glassmorphism",
    "accessible",
    "component-library"
  ],
  "engines": {
    "node": ">=18",
    "pnpm": ">=9"
  },
  "workspaces": [
    "packages/*/*",
    "packages/shared"
  ],
  "scripts": {
    "dev": "vite dev",
    "start:prod": "vite preview && pnpm run build:docs",
    "build": "pnpm run tailwind:build && pnpm tsc -b && vite build && pnpm run build:packages && pnpm run build:docs",
    "build:packages": "lerna run build",
    "publish:packages": "lerna publish from-package",
    "publish:bulk": "./scripts/publish-bulk.sh",
    "publish:component": "./scripts/publish-component.sh",
    "publish:remaining": "./scripts/publish-remaining.sh",
    "publish:one": "./scripts/publish-one.sh",
    "publish:list": "./scripts/list-unpublished.sh",
    "fix:workspace-deps": "./scripts/fix-workspace-deps.sh",
    "sync:paths": "node scripts/sync-path-aliases.mjs",
    "lint": "eslint . --ext ts,tsx --report-unused-disable-directives --max-warnings 0",
    "new:component": "node  ./scripts/create-component/index.js",
    "preview": "vite preview",
    "test": "vitest",
    "sb": "storybook dev -p 6006",
    "sb:build": "storybook build",
    "tailwind:build": "tailwindcss -i ./app/globals.css -o ./dist/output.css --minify",
    "tailwind:watch": "tailwindcss -i ./app/globals.css -o ./dist/output.css --watch",
    "build:docs": "pnpm run sb:build"
  },
  "dependencies": {
    "@radix-ui/react-alert-dialog": "^1.1.15",
    "@radix-ui/react-context-menu": "^2.2.16",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-popover": "^1.1.15",
    "@radix-ui/react-slot": "^1.2.4",
    "@radix-ui/react-switch": "^1.2.6",
    "@radix-ui/react-tooltip": "^1.2.8",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "dompurify": "^3.3.1",
    "lucide-react": "^0.417.0",
    "marked": "^11.2.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tailwind-merge": "^2.6.0",
    "tailwindcss-animate": "^1.0.7"
  },
  "devDependencies": {
    "@chromatic-com/storybook": "^1.9.0",
    "@storybook/addon-essentials": "^8.6.14",
    "@storybook/addon-interactions": "^8.6.14",
    "@storybook/addon-links": "^8.6.15",
    "@storybook/addon-onboarding": "^8.6.15",
    "@storybook/blocks": "^8.6.14",
    "@storybook/react": "^8.6.15",
    "@storybook/react-vite": "^8.6.15",
    "@storybook/test": "^8.6.15",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/jest": "^29.5.14",
    "@types/node": "^22.19.7",
    "@types/react": "^18.3.27",
    "@types/react-dom": "^18.3.7",
    "@typescript-eslint/eslint-plugin": "^7.18.0",
    "@typescript-eslint/parser": "^7.18.0",
    "@vitejs/plugin-react": "^4.7.0",
    "autoprefixer": "^10.4.23",
    "eslint": "^8.57.1",
    "eslint-plugin-react-hooks": "^4.6.2",
    "eslint-plugin-react-refresh": "^0.4.26",
    "eslint-plugin-storybook": "^0.8.0",
    "jsdom": "^24.1.3",
    "lerna": "^9.0.3",
    "postcss": "^8.5.6",
    "sass": "^1.97.2",
    "storybook": "^8.6.15",
    "tailwindcss": "^3.4.19",
    "typescript": "^5.9.3",
    "vite": "^5.4.21",
    "vitest": "^2.1.9"
  }
}