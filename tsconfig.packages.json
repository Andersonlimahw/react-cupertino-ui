{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ESNext",
    "lib": [
      "ES2020",
      "DOM",
      "DOM.Iterable"
    ],
    "jsx": "react-jsx",
    "moduleResolution": "Node",
    "allowSyntheticDefaultImports": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "strict": true,
    "declaration": true,
    "sourceMap": false,
    "downlevelIteration": true,
    "baseUrl": ".",
    "paths": {
      "@react-cupertino-ui/shared": [
        "./packages/shared/dist"
      ],
      "@react-cupertino-ui/shared/*": [
        "./packages/shared/dist/*"
      ],
      "@components/*": [
        "./packages/*"
      ],
      "@react-cupertino-ui/*": [
        "./packages/*"
      ],
      "@globalstyles": [
        "./app/globals.css"
      ],
      "@react-cupertino-ui/intelligence-glow": [
        "./packages/atoms/IntelligenceGlow"
      ],
      "@react-cupertino-ui/page-control": [
        "./packages/atoms/PageControl"
      ],
      "@react-cupertino-ui/siri-waveform": [
        "./packages/atoms/SiriWaveform"
      ],
      "@react-cupertino-ui/voice-indicator": [
        "./packages/atoms/VoiceIndicator"
      ],
      "@react-cupertino-ui/alert": [
        "./packages/molecules/Alert"
      ],
      "@react-cupertino-ui/button": [
        "./packages/molecules/Button"
      ],
      "@react-cupertino-ui/context-menu": [
        "./packages/molecules/ContextMenu"
      ],
      "@react-cupertino-ui/date-picker": [
        "./packages/molecules/DatePicker"
      ],
      "@react-cupertino-ui/picker": [
        "./packages/molecules/Picker"
      ],
      "@react-cupertino-ui/search-bar": [
        "./packages/molecules/SearchBar"
      ],
      "@react-cupertino-ui/stepper": [
        "./packages/molecules/Stepper"
      ],
      "@react-cupertino-ui/text-field": [
        "./packages/molecules/TextField"
      ],
      "@react-cupertino-ui/action-sheet": [
        "./packages/organisms/ActionSheet"
      ],
      "@react-cupertino-ui/bottom-sheet": [
        "./packages/organisms/BottomSheet"
      ],
      "@react-cupertino-ui/card": [
        "./packages/organisms/Card"
      ],
      "@react-cupertino-ui/dialog": [
        "./packages/organisms/Dialog"
      ],
      "@react-cupertino-ui/navigation-bar": [
        "./packages/organisms/NavigationBar"
      ],
      "@react-cupertino-ui/popover": [
        "./packages/organisms/Popover"
      ],
      "@react-cupertino-ui/tab-bar": [
        "./packages/organisms/TabBar"
      ],
      "@react-cupertino-ui/avatar": [
        "./packages/ui/Avatar"
      ],
      "@react-cupertino-ui/badge": [
        "./packages/ui/Badge"
      ],
      "@react-cupertino-ui/caption": [
        "./packages/ui/Caption"
      ],
      "@react-cupertino-ui/checkbox": [
        "./packages/ui/Checkbox"
      ],
      "@react-cupertino-ui/headline": [
        "./packages/ui/Headline"
      ],
      "@react-cupertino-ui/list": [
        "./packages/ui/List"
      ],
      "@react-cupertino-ui/paragraph": [
        "./packages/ui/Paragraph"
      ],
      "@react-cupertino-ui/progress-bar": [
        "./packages/ui/ProgressBar"
      ],
      "@react-cupertino-ui/radio": [
        "./packages/ui/Radio"
